        "import requests\n",
        "import pandas as pd\n",
        "import json\n",
        "from datetime import datetime, timedelta\n",
        "import time\n",
        "\n",
        "# API Configuration\n",
        "API_TOKEN = \"ca757527cb8381ad315cd72b02a0176f8842fa5b548d99e14f4de46f61bcb17a\"\n",
        "BASE_URL = \"https://api.esios.ree.es\"\n",
        "\n",
        "# Headers for authentication - ESIOS uses x-api-key\n",
        "headers = {\n",
        "    'Accept': 'application/json; application/vnd.esios-api-v1+json',\n",
        "    'Content-Type': 'application/json',\n",
        "    'Host': 'api.esios.ree.es',\n",
        "    'x-api-key': API_TOKEN,\n",
        "    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'\n",
        "}\n",
        "\n",
        "# Indicators to extract\n",
        "indicators = {\n",
        "    460: 'demand_forecast',\n",
        "    1293: 'demand_real',\n",
        "    474: 'nuclear_power_availability',\n",
        "    600: 'spot_price_daily'\n",
        "}\n",
        "\n",
        "# Date range - trying different formats\n",
        "start_date = '2024-01-01T00:00:00'\n",
        "end_date = '2024-10-31T23:59:59'\n",
        "\n",
        "# Alternative date formats to try\n",
        "date_formats = {\n",
        "    'iso_full': ('2024-01-01T00:00:00', '2024-10-31T23:59:59'),\n",
        "    'iso_short': ('2024-01-01T00:00', '2024-10-31T23:59'),\n",
        "    'iso_date': ('2024-01-01', '2024-10-31'),\n",
        "    'url_encoded': ('2024-01-01T00%3A00', '2024-10-31T23%3A59'),\n",
        "}\n",
        "\n",
        "def test_api_connection():\n",
        "    \"\"\"\n",
        "    Test basic API connectivity\n",
        "    \"\"\"\n",
        "    print(\"\\n[DEBUG] Testing API connection...\")\n",
        "    url = f\"{BASE_URL}/indicators\"\n",
        "\n",
        "    # Create a session to handle cookies\n",
        "    session = requests.Session()\n",
        "    session.headers.update(headers)\n",
        "\n",
        "    try:\n",
        "        response = session.get(url, timeout=30)\n",
        "        print(f\"  Status Code: {response.status_code}\")\n",
        "\n",
        "        if response.status_code == 200:\n",
        "            data = response.json()\n",
        "            print(f\"  ✓ API is accessible\")\n",
        "            print(f\"  Total indicators available: {len(data.get('indicators', []))}\")\n",
        "            return True, session\n",
        "        else:\n",
        "            print(f\"  ✗ API returned error: {response.text[:200]}\")\n",
        "            return False, None\n",
        "    except Exception as e:\n",
        "        print(f\"  ✗ Connection error: {e}\")\n",
        "        return False, None\n",
        "\n",
        "def get_indicator_description(indicator_id, session=None):\n",
        "    \"\"\"\n",
        "    Fetch indicator description from ESIOS API\n",
        "    \"\"\"\n",
        "    url = f\"{BASE_URL}/indicators\"\n",
        "\n",
        "    try:\n",
        "        if session:\n",
        "            response = session.get(url)\n",
        "        else:\n",
        "            response = requests.get(url, headers=headers)\n",
        "\n",
        "        response.raise_for_status()\n",
        "        data = response.json()\n",
        "\n",
        "        # Find the specific indicator\n",
        "        for indicator in data.get('indicators', []):\n",
        "            if indicator['id'] == indicator_id:\n",
        "                return {\n",
        "                    'id': indicator['id'],\n",
        "                    'name': indicator.get('name'),\n",
        "                    'description': indicator.get('description'),\n",
        "                    'short_name': indicator.get('short_name')\n",
        "                }\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"Error fetching description for indicator {indicator_id}: {e}\")\n",
        "        return None\n",
        "\n",
        "def extract_indicator_data_chunked(indicator_id, start_date, end_date, session=None, chunk_months=2):\n",
        "    \"\"\"\n",
        "    Extract data in chunks for large datasets to avoid timeouts\n",
        "    \"\"\"\n",
        "    print(f\"\\n⚠ Using chunked extraction for indicator {indicator_id} (heavy dataset)...\")\n",
        "\n",
        "    # Parse dates\n",
        "    start = datetime.strptime(start_date[:10], '%Y-%m-%d')\n",
        "    end = datetime.strptime(end_date[:10], '%Y-%m-%d')\n",
        "\n",
        "    all_values = []\n",
        "    current = start\n",
        "    chunk_num = 1\n",
        "\n",
        "    while current < end:\n",
        "        # Calculate chunk end (2 months ahead or end date, whichever is earlier)\n",
        "        chunk_end = min(current + timedelta(days=chunk_months*30), end)\n",
        "\n",
        "        chunk_start_str = current.strftime('%Y-%m-%dT00:00:00')\n",
        "        chunk_end_str = chunk_end.strftime('%Y-%m-%dT23:59:59')\n",
        "\n",
        "        print(f\"  Chunk {chunk_num}: {current.strftime('%Y-%m-%d')} to {chunk_end.strftime('%Y-%m-%d')}\")\n",
        "\n",
        "        # Extract chunk\n",
        "        values = extract_indicator_data(\n",
        "            indicator_id,\n",
        "            chunk_start_str,\n",
        "            chunk_end_str,\n",
        "            session=session,\n",
        "            debug=False,\n",
        "            max_retries=2\n",
        "        )\n",
        "\n",
        "        if values:\n",
        "            all_values.extend(values)\n",
        "            print(f\"    ✓ Got {len(values)} records\")\n",
        "        else:\n",
        "            print(f\"    ✗ No data for this chunk\")\n",
        "\n",
        "        # Move to next chunk\n",
        "        current = chunk_end + timedelta(days=1)\n",
        "        chunk_num += 1\n",
        "        time.sleep(1)  # Be nice to the API\n",
        "\n",
        "    print(f\"  → Total retrieved: {len(all_values)} records\")\n",
        "    return all_values\n",
        "\n",
        "def extract_indicator_data(indicator_id, start_date, end_date, session=None, debug=True, max_retries=3):\n",
        "    \"\"\"\n",
        "    Extract time series data for a specific indicator with detailed debugging\n",
        "    \"\"\"\n",
        "    url = f\"{BASE_URL}/indicators/{indicator_id}\"\n",
        "\n",
        "    params = {\n",
        "        'start_date': start_date,\n",
        "        'end_date': end_date\n",
        "    }\n",
        "\n",
        "    for attempt in range(max_retries):\n",
        "        try:\n",
        "            if attempt > 0:\n",
        "                print(f\"  Retry attempt {attempt + 1}/{max_retries}...\")\n",
        "                time.sleep(2)  # Wait before retry\n",
        "\n",
        "            print(f\"\\nExtracting indicator {indicator_id} ({indicators[indicator_id]})...\")\n",
        "\n",
        "            if debug and attempt == 0:\n",
        "                print(f\"  URL: {url}\")\n",
        "                print(f\"  Params: {params}\")\n",
        "\n",
        "            # Step 1: Get the redirect URL from ESIOS API (don't follow redirects)\n",
        "            if session:\n",
        "                response = session.get(url, params=params, allow_redirects=False, timeout=60)\n",
        "            else:\n",
        "                response = requests.get(url, headers=headers, params=params, allow_redirects=False, timeout=60)\n",
        "\n",
        "            if debug and attempt == 0:\n",
        "                print(f\"  Status Code: {response.status_code}\")\n",
        "\n",
        "            # If we get a redirect (3xx), follow it manually without API headers\n",
        "            if response.status_code in [301, 302, 303, 307, 308]:\n",
        "                redirect_url = response.headers.get('Location')\n",
        "                if debug and attempt == 0:\n",
        "                    print(f\"  Following redirect to S3...\")\n",
        "\n",
        "                # Step 2: Download from S3 without authentication headers\n",
        "                s3_response = requests.get(redirect_url, timeout=90)\n",
        "\n",
        "                # Handle S3 404 errors (expired temp files) - retry with fresh request\n",
        "                if s3_response.status_code == 404:\n",
        "                    if attempt < max_retries - 1:\n",
        "                        print(f\"  ⚠ S3 file expired/not found, requesting fresh URL...\")\n",
        "                        time.sleep(2)\n",
        "                        continue  # Retry from beginning to get new S3 URL\n",
        "                    else:\n",
        "                        s3_response.raise_for_status()\n",
        "\n",
        "                s3_response.raise_for_status()\n",
        "                data = s3_response.json()\n",
        "            else:\n",
        "                # No redirect, process normally\n",
        "                response.raise_for_status()\n",
        "                data = response.json()\n",
        "\n",
        "            if debug and attempt == 0:\n",
        "                print(f\"  Response keys: {list(data.keys())}\")\n",
        "\n",
        "            # Extract time series values\n",
        "            indicator_data = data.get('indicator', {})\n",
        "\n",
        "            if debug and attempt == 0:\n",
        "                print(f\"  Indicator keys: {list(indicator_data.keys())}\")\n",
        "\n",
        "            values = indicator_data.get('values', [])\n",
        "\n",
        "            if debug and attempt == 0:\n",
        "                print(f\"  Values type: {type(values)}, length: {len(values)}\")\n",
        "                if len(values) > 0:\n",
        "                    print(f\"  First record structure: {list(values[0].keys())}\")\n",
        "                    print(f\"  Sample record: {values[0]}\")\n",
        "                else:\n",
        "                    print(f\"  ⚠ No values returned. Check if date range has data.\")\n",
        "\n",
        "            # For indicator 600, filter only Spain data\n",
        "            if indicator_id == 600:\n",
        "                original_count = len(values)\n",
        "                # Check available geo_names\n",
        "                if values and debug and attempt == 0:\n",
        "                    geo_names = set([v.get('geo_name') for v in values if v.get('geo_name')])\n",
        "                    print(f\"  Available geo_names: {geo_names}\")\n",
        "\n",
        "                values = [v for v in values if v.get('geo_name', '').lower() in ['españa', 'spain', 'total']]\n",
        "\n",
        "                if debug and attempt == 0:\n",
        "                    print(f\"  Filtered from {original_count} to {len(values)} records (Spain only)\")\n",
        "\n",
        "            print(f\"  → Retrieved {len(values)} records\")\n",
        "            return values\n",
        "\n",
        "        except requests.exceptions.Timeout as e:\n",
        "            if attempt < max_retries - 1:\n",
        "                print(f\"  ⚠ Timeout error, retrying...\")\n",
        "                continue\n",
        "            else:\n",
        "                print(f\"  ✗ Timeout Error after {max_retries} attempts: {e}\")\n",
        "                return []\n",
        "        except requests.exceptions.RequestException as e:\n",
        "            print(f\"  ✗ HTTP Error: {e}\")\n",
        "            if hasattr(e, 'response') and hasattr(e.response, 'text'):\n",
        "                print(f\"  Response: {e.response.text[:500]}\")\n",
        "            return []\n",
        "        except Exception as e:\n",
        "            print(f\"  ✗ Unexpected error: {e}\")\n",
        "            import traceback\n",
        "            traceback.print_exc()\n",
        "            return []\n",
        "\n",
        "    return []\n",
        "\n",
        "def main():\n",
        "    \"\"\"\n",
        "    Main extraction function\n",
        "    \"\"\"\n",
        "    print(\"=\"*60)\n",
        "    print(\"ESIOS API Data Extraction - DEBUG MODE\")\n",
        "    print(\"=\"*60)\n",
        "\n",
        "    # Test API connection first\n",
        "    success, session = test_api_connection()\n",
        "    if not success:\n",
        "        print(\"\\n✗ Cannot connect to API. Please check:\")\n",
        "        print(\"  1. Internet connection\")\n",
        "        print(\"  2. API token validity\")\n",
        "        print(\"  3. API endpoint availability\")\n",
        "        print(\"\\n💡 Try running from a different network or using a VPN\")\n",
        "        return None, None\n",
        "\n",
        "    # Step 1: Extract indicator descriptions\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"[Step 1] Extracting indicator descriptions...\")\n",
        "    print(\"=\"*60)\n",
        "    descriptions = {}\n",
        "    for ind_id in indicators.keys():\n",
        "        desc = get_indicator_description(ind_id, session)\n",
        "        if desc:\n",
        "            descriptions[ind_id] = desc\n",
        "            print(f\"  ✓ Indicator {ind_id}: {desc.get('name')}\")\n",
        "        else:\n",
        "            print(f\"  ✗ Could not find indicator {ind_id}\")\n",
        "        time.sleep(0.5)\n",
        "\n",
        "    # Save descriptions\n",
        "    if descriptions:\n",
        "        with open('indicator_descriptions.json', 'w', encoding='utf-8') as f:\n",
        "            json.dump(descriptions, f, indent=2, ensure_ascii=False)\n",
        "        print(\"\\n  → Descriptions saved to 'indicator_descriptions.json'\")\n",
        "\n",
        "    # Step 2: Extract time series data (with debug for first indicator)\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"[Step 2] Extracting time series data...\")\n",
        "    print(\"=\"*60)\n",
        "    all_data = {}\n",
        "\n",
        "    # Heavy indicators that need chunking\n",
        "    heavy_indicators = [1293]  # demand_real is known to timeout\n",
        "\n",
        "    for idx, (ind_id, ind_name) in enumerate(indicators.items()):\n",
        "        # Enable detailed debug only for first indicator\n",
        "        debug = (idx == 0)\n",
        "\n",
        "        # Use chunked extraction for heavy indicators\n",
        "        if ind_id in heavy_indicators:\n",
        "            data = extract_indicator_data_chunked(ind_id, start_date, end_date, session, chunk_months=2)\n",
        "        else:\n",
        "            data = extract_indicator_data(ind_id, start_date, end_date, session, debug=debug)\n",
        "\n",
        "        all_data[ind_id] = data\n",
        "        time.sleep(1)\n",
        "\n",
        "    # Step 3: Save raw data\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"[Step 3] Saving raw data...\")\n",
        "    print(\"=\"*60)\n",
        "    with open('raw_data_esios.json', 'w', encoding='utf-8') as f:\n",
        "        json.dump(all_data, f, indent=2, ensure_ascii=False)\n",
        "    print(\"  → Raw data saved to 'raw_data_esios.json'\")\n",
        "\n",
        "    # Step 4: Create summary\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"EXTRACTION SUMMARY\")\n",
        "    print(\"=\"*60)\n",
        "    total_records = 0\n",
        "    for ind_id, ind_name in indicators.items():\n",
        "        count = len(all_data.get(ind_id, []))\n",
        "        total_records += count\n",
        "        status = \"✓\" if count > 0 else \"✗\"\n",
        "        print(f\"  {status} {ind_name:30s} (ID {ind_id}): {count:6d} records\")\n",
        "\n",
        "    if total_records == 0:\n",
        "        print(\"\\n⚠ WARNING: No data was extracted!\")\n",
        "        print(\"  Possible issues:\")\n",
        "        print(\"  1. Date format may be incorrect\")\n",
        "        print(\"  2. Date range may not have data\")\n",
        "        print(\"  3. Indicators may need different parameters\")\n",
        "        print(\"\\n  Check the debug output above for details.\")\n",
        "    else:\n",
        "        print(f\"\\n✓ Extraction complete! Total: {total_records} records\")\n",
        "\n",
        "    print(\"=\"*60)\n",
        "\n",
        "    return all_data, descriptions\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    data, descriptions = main()\n",
        ""
