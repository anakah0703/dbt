      "source": [
        "\"\"\"\n",
        "ESIOS Data Transformation - Hybrid Approach\n",
        "============================================\n",
        "Strategy:\n",
        "- PySpark for core ETL transformations (scalable, production-ready)\n",
        "- Pandas + Sklearn for advanced ML features (better ecosystem for anomaly detection)\n",
        "\n",
        "This hybrid approach balances production best practices with analytical sophistication.\n",
        "\"\"\"\n",
        "\n",
        "import json\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# PySpark imports\n",
        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql import functions as F\n",
        "from pyspark.sql.window import Window\n",
        "from pyspark.sql.types import StructType, StructField, StringType, DoubleType, TimestampType\n",
        "\n",
        "# Pandas & ML imports (for advanced analytics)\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.ensemble import IsolationForest\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "print(\"=\"*70)\n",
        "print(\"ESIOS DATA TRANSFORMATION - HYBRID PYSPARK + PANDAS APPROACH\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# ============================================================================\n",
        "# Initialize Spark Session\n",
        "# ============================================================================\n",
        "print(\"\\n[Init] Starting Spark Session...\")\n",
        "\n",
        "spark = SparkSession.builder \\\n",
        "    .appName(\"ESIOS_ETL_Transform\") \\\n",
        "    .config(\"spark.driver.memory\", \"4g\") \\\n",
        "    .config(\"spark.sql.adaptive.enabled\", \"true\") \\\n",
        "    .getOrCreate()\n",
        "\n",
        "spark.sparkContext.setLogLevel(\"ERROR\")\n",
        "print(f\"  ✓ Spark {spark.version} initialized\")\n",
        "\n",
        "# ============================================================================\n",
        "# PART 1: PYSPARK TRANSFORMATIONS (Core ETL)\n",
        "# ============================================================================\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"PART 1: PYSPARK TRANSFORMATIONS\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 1: Load Raw Data\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 1] Loading raw data from JSON...\")\n",
        "\n",
        "with open('raw_data_esios.json', 'r', encoding='utf-8') as f:\n",
        "    raw_data = json.load(f)\n",
        "\n",
        "print(f\"  ✓ Demand Forecast: {len(raw_data.get('460', []))} records\")\n",
        "print(f\"  ✓ Demand Real: {len(raw_data.get('1293', []))} records\")\n",
        "print(f\"  ✓ Nuclear Availability: {len(raw_data.get('474', []))} records\")\n",
        "print(f\"  ✓ Spot Price: {len(raw_data.get('600', []))} records\")\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 2: Create Spark DataFrames from Raw Data\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 2] Creating Spark DataFrames...\")\n",
        "\n",
        "def create_spark_df(data, value_col_name):\n",
        "    \"\"\"Convert raw JSON to Spark DataFrame\"\"\"\n",
        "    # Extract datetime and value\n",
        "    records = [\n",
        "        (row['datetime_utc'], float(row['value']))\n",
        "        for row in data if row.get('value') is not None\n",
        "    ]\n",
        "\n",
        "    schema = StructType([\n",
        "        StructField(\"datetime\", StringType(), True),\n",
        "        StructField(value_col_name, DoubleType(), True)\n",
        "    ])\n",
        "\n",
        "    df = spark.createDataFrame(records, schema)\n",
        "    df = df.withColumn(\"datetime\", F.to_timestamp(\"datetime\"))\n",
        "    return df\n",
        "\n",
        "# Create DataFrames for each indicator\n",
        "df_demand_forecast = create_spark_df(raw_data.get('460', []), 'demand_forecast')\n",
        "df_demand_real = create_spark_df(raw_data.get('1293', []), 'demand_real')\n",
        "df_nuclear = create_spark_df(raw_data.get('474', []), 'nuclear_power_availability')\n",
        "df_spot_price = create_spark_df(raw_data.get('600', []), 'spot_price_daily')\n",
        "\n",
        "print(f\"  ✓ Spark DataFrames created\")\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 3: Join All Indicators (PySpark outer join)\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 3] Joining all indicators with PySpark...\")\n",
        "\n",
        "df = df_demand_forecast \\\n",
        "    .join(df_demand_real, on='datetime', how='outer') \\\n",
        "    .join(df_nuclear, on='datetime', how='outer') \\\n",
        "    .join(df_spot_price, on='datetime', how='outer') \\\n",
        "    .orderBy('datetime')\n",
        "\n",
        "print(f\"  ✓ Joined DataFrame count: {df.count():,} records\")\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 4: Core Transformations with PySpark\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 4] Calculating features with PySpark...\")\n",
        "\n",
        "# 4.1 Forecast Errors\n",
        "df = df.withColumn('forecast_error',\n",
        "                   F.col('demand_forecast') - F.col('demand_real'))\n",
        "df = df.withColumn('forecast_error_abs',\n",
        "                   F.abs(F.col('forecast_error')))\n",
        "df = df.withColumn('forecast_error_pct',\n",
        "                   (F.col('forecast_error') / F.col('demand_real')) * 100)\n",
        "\n",
        "print(\"  ✓ Forecast errors calculated\")\n",
        "\n",
        "# 4.2 Hour-over-hour ramps\n",
        "window_spec = Window.orderBy('datetime')\n",
        "\n",
        "df = df.withColumn('demand_real_ramp_1h',\n",
        "                   F.col('demand_real') - F.lag('demand_real', 1).over(window_spec))\n",
        "df = df.withColumn('demand_forecast_ramp_1h',\n",
        "                   F.col('demand_forecast') - F.lag('demand_forecast', 1).over(window_spec))\n",
        "\n",
        "print(\"  ✓ Hour-over-hour ramps calculated\")\n",
        "\n",
        "# 4.3 Rolling 24-hour volatility (standard deviation)\n",
        "window_24h = Window.orderBy('datetime').rowsBetween(-23, 0)\n",
        "\n",
        "df = df.withColumn('demand_volatility_24h',\n",
        "                   F.stddev('demand_real').over(window_24h))\n",
        "\n",
        "print(\"  ✓ Rolling volatility calculated\")\n",
        "\n",
        "# 4.4 Nuclear share (bounded 0-1)\n",
        "df = df.withColumn('nuclear_share_raw',\n",
        "                   F.col('nuclear_power_availability') / F.col('demand_real'))\n",
        "df = df.withColumn('nuclear_share',\n",
        "                   F.when(F.col('nuclear_share_raw') > 1, 1)\n",
        "                    .when(F.col('nuclear_share_raw') < 0, 0)\n",
        "                    .otherwise(F.col('nuclear_share_raw')))\n",
        "df = df.drop('nuclear_share_raw')\n",
        "\n",
        "print(\"  ✓ Nuclear share calculated\")\n",
        "\n",
        "# 4.5 Price returns and volatility\n",
        "df = df.withColumn('spot_price_return_1d',\n",
        "                   (F.col('spot_price_daily') - F.lag('spot_price_daily', 24).over(window_spec))\n",
        "                   / F.lag('spot_price_daily', 24).over(window_spec))\n",
        "\n",
        "df = df.withColumn('spot_price_return_7d',\n",
        "                   (F.col('spot_price_daily') - F.lag('spot_price_daily', 24*7).over(window_spec))\n",
        "                   / F.lag('spot_price_daily', 24*7).over(window_spec))\n",
        "\n",
        "window_7d = Window.orderBy('datetime').rowsBetween(-24*7, 0)\n",
        "df = df.withColumn('spot_price_volatility_7d',\n",
        "                   F.stddev('spot_price_daily').over(window_7d))\n",
        "\n",
        "print(\"  ✓ Price returns and volatility calculated\")\n",
        "\n",
        "# 4.6 Time-based features\n",
        "df = df.withColumn('hour', F.hour('datetime'))\n",
        "df = df.withColumn('day_of_week', F.dayofweek('datetime') - 1)  # 0=Monday\n",
        "df = df.withColumn('month', F.month('datetime'))\n",
        "df = df.withColumn('is_weekend',\n",
        "                   F.when(F.col('day_of_week') >= 5, 1).otherwise(0))\n",
        "\n",
        "print(\"  ✓ Time-based features added\")\n",
        "\n",
        "print(f\"\\n  ✓ PySpark transformations complete!\")\n",
        "print(f\"  Total columns: {len(df.columns)}\")\n",
        "\n",
        "# ============================================================================\n",
        "# PART 2: PANDAS + ML TRANSFORMATIONS (Advanced Analytics)\n",
        "# ============================================================================\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"PART 2: ADVANCED ML ANALYTICS (Pandas + Sklearn)\")\n",
        "print(\"Rationale: Sklearn's ML ecosystem is more mature than PySpark MLlib\")\n",
        "print(\"for unsupervised learning. In production, we'd use PySpark MLlib or\")\n",
        "print(\"distributed alternatives for Big Data.\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# Convert to Pandas for ML operations\n",
        "print(\"\\n[Step 5] Converting to Pandas for ML operations...\")\n",
        "df_pandas = df.toPandas()\n",
        "print(f\"  ✓ Converted to Pandas: {df_pandas.shape}\")\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 6: 🚀 Grid Stress Score (Advanced Feature Engineering)\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 6] 🚀 Calculating GRID STRESS SCORE...\")\n",
        "\n",
        "def normalize_score(series, inverse=False):\n",
        "    \"\"\"Normalize to 0-1, optionally inverse\"\"\"\n",
        "    series_clean = series.fillna(series.median())\n",
        "    min_val = series_clean.min()\n",
        "    max_val = series_clean.max()\n",
        "    if max_val == min_val:\n",
        "        return pd.Series(0, index=series.index)\n",
        "    normalized = (series_clean - min_val) / (max_val - min_val)\n",
        "    return 1 - normalized if inverse else normalized\n",
        "\n",
        "# Stress components\n",
        "stress_forecast_error = normalize_score(df_pandas['forecast_error_abs'])\n",
        "stress_nuclear_share = normalize_score(df_pandas['nuclear_share'], inverse=True)\n",
        "stress_ramp_speed = normalize_score(df_pandas['demand_real_ramp_1h'].abs())\n",
        "stress_price_volatility = normalize_score(df_pandas['spot_price_volatility_7d'])\n",
        "\n",
        "# Weighted Grid Stress Score\n",
        "df_pandas['grid_stress_score'] = (\n",
        "    0.30 * stress_forecast_error +\n",
        "    0.25 * stress_nuclear_share +\n",
        "    0.25 * stress_ramp_speed +\n",
        "    0.20 * stress_price_volatility\n",
        ")\n",
        "\n",
        "# Stress level classification\n",
        "df_pandas['stress_level'] = pd.cut(\n",
        "    df_pandas['grid_stress_score'],\n",
        "    bins=[0, 0.33, 0.66, 1.0],\n",
        "    labels=['Low', 'Medium', 'High']\n",
        ")\n",
        "\n",
        "print(f\"  ✓ Grid Stress Score calculated\")\n",
        "stress_dist = df_pandas['stress_level'].value_counts()\n",
        "for level in ['Low', 'Medium', 'High']:\n",
        "    count = stress_dist.get(level, 0)\n",
        "    pct = count / len(df_pandas) * 100\n",
        "    print(f\"    - {level} Stress: {count:,} hours ({pct:.1f}%)\")\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 7: 🚀 Anomaly Detection with Isolation Forest\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 7] 🚀 Detecting ANOMALIES with Isolation Forest...\")\n",
        "\n",
        "anomaly_features = [\n",
        "    'demand_real', 'nuclear_power_availability',\n",
        "    'spot_price_daily', 'forecast_error_abs'\n",
        "]\n",
        "\n",
        "df_anomaly = df_pandas[anomaly_features].copy()\n",
        "df_anomaly_clean = df_anomaly.dropna()\n",
        "\n",
        "if len(df_anomaly_clean) > 100:\n",
        "    scaler = StandardScaler()\n",
        "    X_scaled = scaler.fit_transform(df_anomaly_clean)\n",
        "\n",
        "    iso_forest = IsolationForest(\n",
        "        contamination=0.05,\n",
        "        random_state=42,\n",
        "        n_estimators=100\n",
        "    )\n",
        "\n",
        "    predictions = iso_forest.fit_predict(X_scaled)\n",
        "    anomaly_scores = iso_forest.score_samples(X_scaled)\n",
        "\n",
        "    df_pandas['is_anomaly'] = 0\n",
        "    df_pandas['anomaly_score'] = np.nan\n",
        "    df_pandas.loc[df_anomaly_clean.index, 'is_anomaly'] = (predictions == -1).astype(int)\n",
        "    df_pandas.loc[df_anomaly_clean.index, 'anomaly_score'] = anomaly_scores\n",
        "\n",
        "    n_anomalies = df_pandas['is_anomaly'].sum()\n",
        "    print(f\"  ✓ Detected {n_anomalies} anomalies ({n_anomalies / len(df_pandas) * 100:.2f}%)\")\n",
        "\n",
        "    # Classify anomaly types\n",
        "    def classify_anomaly(row):\n",
        "        if row['is_anomaly'] == 0:\n",
        "            return 'Normal'\n",
        "\n",
        "        price_high = row['spot_price_daily'] > df_pandas['spot_price_daily'].quantile(0.75)\n",
        "        price_low = row['spot_price_daily'] < df_pandas['spot_price_daily'].quantile(0.25)\n",
        "        nuclear_high = row['nuclear_share'] > df_pandas['nuclear_share'].quantile(0.75)\n",
        "        nuclear_low = row['nuclear_share'] < df_pandas['nuclear_share'].quantile(0.25)\n",
        "        forecast_error_high = row['forecast_error_abs'] > df_pandas['forecast_error_abs'].quantile(0.90)\n",
        "\n",
        "        if price_high and nuclear_low:\n",
        "            return 'Grid Stress Event'\n",
        "        elif price_low and nuclear_high:\n",
        "            return 'Renewable Oversupply'\n",
        "        elif forecast_error_high:\n",
        "            return 'Forecast Failure'\n",
        "        else:\n",
        "            return 'Other Anomaly'\n",
        "\n",
        "    df_pandas['anomaly_type'] = df_pandas.apply(classify_anomaly, axis=1)\n",
        "\n",
        "    print(\"\\n  Anomaly Classification:\")\n",
        "    for anom_type, count in df_pandas['anomaly_type'].value_counts().items():\n",
        "        if anom_type != 'Normal':\n",
        "            print(f\"    - {anom_type}: {count} events\")\n",
        "else:\n",
        "    df_pandas['is_anomaly'] = 0\n",
        "    df_pandas['anomaly_score'] = 0\n",
        "    df_pandas['anomaly_type'] = 'Normal'\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 8: 🚀 Market Regime Classification with K-Means\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 8] 🚀 Identifying MARKET REGIMES with K-Means...\")\n",
        "\n",
        "regime_features = ['nuclear_share', 'spot_price_daily', 'demand_volatility_24h']\n",
        "df_regime = df_pandas[regime_features].copy()\n",
        "df_regime_clean = df_regime.dropna()\n",
        "\n",
        "if len(df_regime_clean) > 100:\n",
        "    scaler_regime = StandardScaler()\n",
        "    X_regime_scaled = scaler_regime.fit_transform(df_regime_clean)\n",
        "\n",
        "    kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "    clusters = kmeans.fit_predict(X_regime_scaled)\n",
        "\n",
        "    df_regime_clean['cluster'] = clusters\n",
        "    cluster_means = df_regime_clean.groupby('cluster')[regime_features].mean()\n",
        "\n",
        "    # Map clusters to interpretable regimes\n",
        "    cluster_order = cluster_means['spot_price_daily'].sort_values().index\n",
        "    regime_mapping = {\n",
        "        cluster_order[0]: 'Renewable Oversupply',\n",
        "        cluster_order[1]: 'Stable Base Load',\n",
        "        cluster_order[2]: 'Grid Stress'\n",
        "    }\n",
        "\n",
        "    df_pandas['market_regime'] = 'Unknown'\n",
        "    df_pandas.loc[df_regime_clean.index, 'market_regime'] = df_regime_clean['cluster'].map(regime_mapping)\n",
        "\n",
        "    print(f\"  ✓ Market regimes identified:\")\n",
        "    for regime, count in df_pandas['market_regime'].value_counts().items():\n",
        "        if regime != 'Unknown':\n",
        "            pct = count / len(df_pandas) * 100\n",
        "            print(f\"    - {regime}: {count:,} hours ({pct:.1f}%)\")\n",
        "else:\n",
        "    df_pandas['market_regime'] = 'Unknown'\n",
        "\n",
        "# ============================================================================\n",
        "# STEP 9: Save Final Output\n",
        "# ============================================================================\n",
        "print(\"\\n[Step 9] Saving transformed data...\")\n",
