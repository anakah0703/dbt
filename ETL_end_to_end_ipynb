        "df_final['datetime'] = pd.to_datetime(df_final['datetime']).dt.strftime('%Y-%m-%d %H:%M:%S')\n",
        "\n",
        "# Save to CSV\n",
        "output_filename = 'transformed_esios_data.csv'\n",
        "df_final.to_csv(output_filename, index=False)\n",
        "\n",
        "print(f\"  ✓ Saved to '{output_filename}'\")\n",
